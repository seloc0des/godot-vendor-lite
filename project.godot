; Demo / dev project for Vendor — Lite.

config_version=5

[application]

config/name="Vendor (Lite) · Demo"
config/description="Free single-currency shop for Godot 4.5+."
config/features=PackedStringArray("4.5", "GL Compatibility")
run/main_scene="res://demo/vendor_demo.tscn"

[display]

window/size/viewport_width=900
window/size/viewport_height=540

[editor_plugins]

enabled=PackedStringArray("res://addons/vendor_lite/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
